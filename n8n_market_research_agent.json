        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"Qwen/Qwen3-30B-A3B-Instruct-2507\",\n  temperature: 0.2,\n  messages: [\n    { role: \"system\", content: \"You are Agent 1, a competitor-discovery agent. Given raw search results about a company, identify its 3 closest real-world competitors. Reply with ONLY a JSON array of 3 strings, no prose, e.g. [\\\"Competitor A\\\",\\\"Competitor B\\\",\\\"Competitor C\\\"].\" },\n    { role: \"user\", content: \"Company: \" + $json.company_name + \"\\n\\nSearch results:\\n\" + JSON.stringify($json.results || $json.body || {}) }\n  ]\n}) }}"
      },
      "id": "agent1_llm_parse",
      "name": "Agent 1: LLM - Identify Top 3 Competitors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -740,
        0
      ],
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "let names = [];\nlet errorFlag = false;\ntry {\n  const content = $input.first().json.choices[0].message.content;\n  names = JSON.parse(content);\n  if (!Array.isArray(names)) throw new Error('not an array');\n  names = names.slice(0, 3).map(n => String(n));\n} catch (e) {\n  errorFlag = true;\n  names = [];\n}\nreturn [{ json: { company_name: $('Normalize Input').first().json.company_name, competitors: names, discovery_error: errorFlag } }];"
      },
      "id": "parse_competitors",
      "name": "Parse Competitor List (with fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
